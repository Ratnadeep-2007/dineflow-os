# Baileys Gateway Environment Variables
# Copy this to .env and fill in your values

REDIS_HOST=localhost
REDIS_PORT=6379

# Your restaurant's WhatsApp phone number (with country code, no + sign)
# e.g. 919876543210
RESTAURANT_PHONE=

# The base URL of your frontend menu dashboard
MENU_DASHBOARD_URL=http://localhost:5173/menu

# Deep links for delivery platforms
ZOMATO_URL=https://zomato.com/your-restaurant-slug
SWIGGY_URL=https://swiggy.com/city/your-restaurant
DINEOUT_URL=https://www.dineout.co.in/your-restaurant

# Backend NestJS API base URL (for pushing orders)
BACKEND_URL=http://localhost:3000
