# ==============================================================================
# DINEFLOW AI — Production Environment Variables
# Copy this file to .env and replace with your production keys:
# cp .env.example .env
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=wp_automation

# AI Provider (Google Gemini)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_random_string_min_32_chars
JWT_EXPIRES_IN=15m
META_APP_SECRET=your_meta_app_secret_if_using_meta_cloud_api

# Telegram Gateway (Optional / Bot Support)
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Public URLs (Replace with your domain or VPS IP)
MENU_DASHBOARD_URL=http://localhost:5173/menu
