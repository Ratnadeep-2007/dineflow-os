# DINE AI — Telegram Bot Environment Variables
# Copy this to .env and fill in your values

# Get this from @BotFather on Telegram
# Steps: Open Telegram → search @BotFather → /newbot → give it a name → get token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Bot username (without @)
BOT_USERNAME=DineAI_Bot

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Your frontend menu dashboard URL (guests tap this to browse the kiosk menu)
MENU_DASHBOARD_URL=http://localhost:5173/menu

# Delivery platform deep links — replace with your actual restaurant slugs
ZOMATO_URL=https://zomato.com/your-restaurant-slug
SWIGGY_URL=https://www.swiggy.com/city/your-restaurant-slug
DINEOUT_URL=https://www.dineout.co.in/your-restaurant

# NestJS backend API (receives ticket pushes)
BACKEND_URL=http://localhost:3000
